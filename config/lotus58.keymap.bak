#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
// ┌─────────┬─────┬─────┬─────┬─────┬─────┐                            ┌─────┬─────┬─────┬─────┬─────┬────────┐
// │   ESC   │  1  │  2  │  3  │  4  │  5  │                            │  6  │  7  │  8  │  9  │  0  │   =    │
// ├─────────┼─────┼─────┼─────┼─────┼─────┤                            ├─────┼─────┼─────┼─────┼─────┼────────┤
// │    `    │  Q  │  W  │  E  │  R  │  T  │                            │  Y  │  U  │  I  │  O  │  P  │   [    │
// ├─────────┼─────┼─────┼─────┼─────┼─────┼──────────┐  ┌─────────────┼─────┼─────┼─────┼─────┼─────┼────────┤
// │   TAB   │  A  │  S  │  D  │SFT/F│  G  │   MUTE   │  │    MUTE     │  H  │SFT/J│  K  │  L  │  ;  │   '    │
// ├─────────┼─────┼─────┼─────┼─────┼─────┼──────────┤  ├─────────────┼─────┼─────┼─────┼─────┼─────┼────────┤
// │  LCTRL  │  Z  │  X  │  C  │  V  │  B  │  ADJUST  │  │     DEL     │  N  │  M  │  ,  │  .  │  /  │ RCTL/\ │
// └─────────┴─────┴─────┴─────┴─────┴─────┴──────────┘  └─────────────┴─────┴─────┴─────┴─────┴─────┴────────┘
//                     ┌──────┬──────┬───────┬────────┐      ┌──────┬───────┬──────┬──────┐
//                     │ LGUI │ LALT │ LOWER │  SPC   │      │ ENT  │ RAISE │ BSPC │ RGUI │
//                     └──────┴──────┴───────┴────────┘      └──────┴───────┴──────┴──────┘
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4        &kp N5                                  &kp N6  &kp N7        &kp N8    &kp N9   &kp N0    &kp EQUAL
&kp GRAVE  &kp Q   &kp W   &kp E   &kp R         &kp T                                   &kp Y   &kp U         &kp I     &kp O    &kp P     &kp LBKT
&kp TAB    &kp A   &kp S   &kp D   &hm LSHFT F   &kp G   &kp C_MUTE    &kp C_MUTE       &kp H   &hm RSHFT J   &kp K     &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C   &kp V         &kp B   &mo ADJUST    &kp DEL          &kp N   &kp M         &kp COMMA &kp DOT  &kp FSLH  &mt RCTRL BSLH
                            &kp LGUI  &kp LALT  &mo LOWER  &kp SPACE    &kp RET  &mo RAISE  &kp BSPC  &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "Lower";
// Left side transparent (falls through to default alpha keys).
// Right side: HJKL arrows on home row, Home/PgDn/PgUp/End on Z row.
// ┌─────────┬─────┬─────┬─────┬─────┬─────┐                            ┌───────┬──────┬───────┬──────┬───────┬────────┐
// │         │  F1 │  F2 │  F3 │  F4 │  F5 │                            │  F6   │  F7  │  F8   │  F9  │  F10  │        │
// ├─────────┼─────┼─────┼─────┼─────┼─────┤                            ├───────┼──────┼───────┼──────┼───────┼────────┤
// │         │     │     │     │     │     │                            │ MENU  │ INS  │ PSCR  │ SLCK │ PAUSE │        │
// ├─────────┼─────┼─────┼─────┼─────┼─────┼──────────┐  ┌─────────────┼───────┼──────┼───────┼──────┼───────┼────────┤
// │         │     │     │     │     │     │          │  │             │  ←    │  ↓   │   ↑   │  →   │ CAPS  │        │
// ├─────────┼─────┼─────┼─────┼─────┼─────┼──────────┤  ├─────────────┼───────┼──────┼───────┼──────┼───────┼────────┤
// │         │     │     │     │     │     │  ADJUST  │  │             │ HOME  │ PG↓  │  PG↑  │ END  │       │        │
// └─────────┴─────┴─────┴─────┴─────┴─────┴──────────┘  └─────────────┴───────┴──────┴───────┴──────┴───────┴────────┘
//                     ┌──────┬──────┬───────┬────────┐      ┌──────┬────────┬──────┬──────┐
//                     │  F11 │      │▓▓▓▓▓▓▓│        │      │      │ ADJUST │      │  F12 │
//                     └──────┴──────┴───────┴────────┘      └──────┴────────┴──────┴──────┘
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                          &kp F6       &kp F7   &kp F8    &kp F9    &kp F10        &trans
&trans  &trans  &trans  &trans  &trans  &trans                           &kp K_CMENU  &kp INS  &kp PSCRN &kp SLCK  &kp PAUSE_BREAK &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans      &trans      &kp LEFT     &kp DOWN &kp UP    &kp RIGHT &kp CLCK       &trans
&trans  &trans  &trans  &trans  &trans  &trans   &mo ADJUST  &trans      &kp HOME     &kp PG_DN &kp PG_UP &kp END  &trans         &trans
                        &kp F11 &trans  &trans   &trans      &trans      &mo ADJUST   &trans   &kp F12
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };

        raise_layer {
            display-name = "Raise";
// Symbols verbatim from hillside Layer 2. Left = ` & * ( / ' $ % ^ / " ! @ #
//                                         Right = _ - ( ) = / [ ] { } \ / | + < > /
// BT and system on number row.
// ┌───────────┬───────┬───────┬───────┬───────┬───────┐                         ┌─────────┬────────┬────────┬──────┬────────┬──────────┐
// │  BT CLR   │  BT1  │  BT2  │  BT3  │  BT4  │  BT5  │                         │ OUT TOG │OUT USB │OUT BLE │      │ RESET  │  FLASH   │
// ├───────────┼───────┼───────┼───────┼───────┼───────┤                         ├─────────┼────────┼────────┼──────┼────────┼──────────┤
// │           │   `   │   &   │   *   │   (   │       │                         │    _    │   -    │   (    │  )   │   =    │          │
// ├───────────┼───────┼───────┼───────┼───────┼───────┼──────────┐ ┌────────────┼─────────┼────────┼────────┼──────┼────────┼──────────┤
// │           │   '   │   $   │   %   │   ^   │       │          │ │            │    [    │   ]    │   {    │  }   │   \    │          │
// ├───────────┼───────┼───────┼───────┼───────┼───────┼──────────┤ ├────────────┼─────────┼────────┼────────┼──────┼────────┼──────────┤
// │           │   "   │   !   │   @   │   #   │       │  ADJUST  │ │            │    |    │   +    │   <    │  >   │   /    │          │
// └───────────┴───────┴───────┴───────┴───────┴───────┴──────────┘ └────────────┴─────────┴────────┴────────┴──────┴────────┴──────────┘
//                         ┌──────┬──────┬────────┬──────┐      ┌──────┬──────┬──────┬──────┐
//                         │      │      │ ADJUST │      │      │      │▓▓▓▓▓▓│      │      │
//                         └──────┴──────┴────────┴──────┘      └──────┴──────┴──────┴──────┘
            bindings = <
&bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                      &out OUT_TOG &out OUT_USB &out OUT_BLE &trans    &sys_reset  &bootloader
&trans         &kp GRAVE    &kp AMPS     &kp STAR     &kp LPAR     &trans                              &kp UNDER    &kp MINUS    &kp LPAR     &kp RPAR  &kp EQUAL   &trans
&trans         &kp SQT      &kp DLLR     &kp PRCNT    &kp CARET    &trans   &trans       &trans        &kp LBKT     &kp RBKT     &kp LBRC     &kp RBRC  &kp BSLH    &trans
&trans         &kp LS(SQT)  &kp EXCL     &kp AT       &kp HASH     &trans   &mo ADJUST   &trans        &kp PIPE     &kp PLUS     &kp LS(COMMA) &kp LS(DOT) &kp FSLH &trans
                                         &trans       &trans       &mo ADJUST &trans     &trans        &trans       &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&trans  &trans          &trans          &trans           &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &mmv MOVE_UP    &trans           &trans  &msc SCRL_UP                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &msc SCRL_DOWN  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans          &trans           &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &mkp LCLK        &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
